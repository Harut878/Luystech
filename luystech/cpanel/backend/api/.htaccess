# config.php-ն ու lib/-ը ուղիղ բրաուզերից հասանելի չեն
<FilesMatch "^(config|config\.sample)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
DirectoryIndex index.php
