# ═══ HospIT — environment variables ═══
# Copy to `.env.local` (local dev) or `.env` (docker compose), or set them in your server / CI.
# All values are read at RUNTIME — nothing needs to be present when running `next build`.

# ── REQUIRED ──
# PostgreSQL 13+ connection string. Special characters in the password must be URL-encoded.
# docker compose with the bundled "db" service: leave DATABASE_URL EMPTY (it is built from POSTGRES_PASSWORD).
DATABASE_URL=postgres://hospit:CHANGE_ME@localhost:5432/hospit
# TLS to the database: empty = as in the connection string | require = verified certificate |
# no-verify = encrypted, certificate not verified (managed DBs with self-signed certs)
DATABASE_SSL=

# docker compose only: password of the bundled PostgreSQL container (DATABASE_URL is built from it)
POSTGRES_PASSWORD=CHANGE_ME

# ── FIRST ADMIN (docker only, optional) ──
# On start, if the database has NO admin yet, this account is created. Ignored afterwards —
# remove the password from .env after the first start. Without docker:  npm run db:create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── OPTIONAL ──
# Public address of the site — used in password-reset e-mails.
SITE_URL=https://hospit.am
# Session cookies are "Secure" (HTTPS only) in production. Set to false ONLY for testing over plain http.
# COOKIE_SECURE=false

# E-mail via Resend (https://resend.com): password-reset links + contact-form notifications.
# If unset, contact requests are still saved and shown in the admin panel, and "forgot password"
# tells users to contact the administrator (an admin can set a new password in Admin → Users).
# RESEND_API_KEY=re_...
# MAIL_FROM=HospIT <noreply@hospit.am>
# CONTACT_TO_EMAIL=dr.hospit@progress.am

# Max DB connections per app instance (default 10)
# DATABASE_POOL_MAX=10
